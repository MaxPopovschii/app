{
  "name": "launchcheck",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "api",
    "worker",
    "web",
    "fetcher"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w api && npm run build -w fetcher && npm run build -w worker && npm run build:check -w web",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "start": "npm run start -w api",
    "dev:web": "npm run dev -w web",
    "provision": "node api/dist/provision.js"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
